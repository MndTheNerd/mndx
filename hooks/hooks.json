{
  "description": "MNDX hard gate: blocks code edits until the active work item's docs are approved, and records approvals only from user-typed /mndx:approve and /mndx:autopilot.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Skill",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/gate.js"], "timeout": 15 }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/approve.js"], "timeout": 15 }
        ]
      }
    ]
  }
}
